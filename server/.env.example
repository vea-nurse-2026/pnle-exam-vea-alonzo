# Copy this file to .env and fill in your key.
# Get a key at https://platform.claude.com (Settings -> API keys).
ANTHROPIC_API_KEY=

# Try the app without a key: Generate returns built-in test questions instead of calling Claude.
MOCK_AI=false

# Optional settings
# REQUIRE_LOGIN=true           # turn studio sign-in back on (off by default; the studio then only listens on this computer)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high            # low | medium | high | xhigh | max (lower = cheaper, faster)
# MAX_CONTEXT_CHARS=120000      # how much source text is sent per request (~4 chars per token)
# PORT=4100                     # if you change this, update the proxy in client/vite.config.ts too
# COOKIE_SECURE=true            # set when served over HTTPS
